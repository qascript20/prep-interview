# Server secrets only. Never copy these into dist/ or browser JavaScript.
E2B_API_KEY=
E2B_TEMPLATE_ID=
# Set only after provider/region review and sandbox acceptance tests.
PILOT_EXECUTION_ENABLED=false
PILOT_PROCESSING_REGION=Not configured
PILOT_ADMIN_TOKEN=
# Set to sites only behind the trusted Sites identity gateway.
PILOT_IDENTITY_BOUNDARY=unconfigured
# 60 GBP execution allocation. Reserve an upper bound for every admitted job.
PILOT_EXECUTION_BUDGET_PENCE=6000
PILOT_JOB_RESERVATION_PENCE=5
PILOT_DAILY_RUN_LIMIT=20
# AI stays disabled until the expert benchmark is independently reviewed.
PILOT_AI_ENABLED=false
# Interview Studio uses a separate, explicitly enabled Gemini Live integration.
# Add these only to the ignored local .env file or server runtime secrets.
GEMINI_API_KEY=
GEMINI_STUDIO_ENABLED=false
GEMINI_LIVE_MODEL=gemini-3.8-live
# Conservative session-capacity accounting, not a provider billing guarantee.
GEMINI_STUDIO_BUDGET_PENCE=1500
GEMINI_STUDIO_RESERVATION_PENCE=100
# Stripe subscription: create an active recurring GBP 9.99/month Price in Stripe.
# Start with Stripe test credentials. Never put these in browser code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
BILLING_ENABLED=false
PUBLIC_BASE_URL=http://127.0.0.1:8796
